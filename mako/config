# ─────────────────────────────────────────────
# Mako notification daemon
# ─────────────────────────────────────────────

# Font
font=JetBrainsMono Nerd Font 12

# ─────────────────────────────────────────────
# Colors
# ─────────────────────────────────────────────

background-color=#11111b
text-color=#cdd6f4
border-color=#45475a
progress-color=over #89b4fa

# ─────────────────────────────────────────────
# Border / geometry
# ─────────────────────────────────────────────

border-size=1

# ─────────────────────────────────────────────
# Icons
# ─────────────────────────────────────────────

icons=1
max-icon-size=48
icon-location=left

# ─────────────────────────────────────────────
# Notification layout
# ─────────────────────────────────────────────

markup=1
layer=overlay
anchor=top-right

outer-margin=0
margin=5
padding=6

width=300
height=150

# ─────────────────────────────────────────────
# Behaviour
# ─────────────────────────────────────────────

# Default timeout: 4 seconds
default-timeout=4000
ignore-timeout=0

sort=-time
max-visible=5

group-by=app-name

# ─────────────────────────────────────────────
# Format
# ─────────────────────────────────────────────

# %s = notification summary
# %b = notification body
#
# Summary is bold and larger than the body.
format=<big><b>%s</b></big>\n%b

[grouped=true]
format=<big><b>%s</b></big>\n%b

# ─────────────────────────────────────────────
# Urgency
# ─────────────────────────────────────────────

[urgency=low]
text-color=#a6adc8
border-color=#313244

[urgency=normal]
text-color=#cdd6f4
border-color=#45475a

[urgency=high]
text-color=#f38ba8
border-color=#f38ba8
